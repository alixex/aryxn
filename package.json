{
  "name": "aryxn-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "A user-sovereignty-first vault for accounts and permanent files with integrated DEX.",
  "license": "AGPL-3.0-or-later",
  "author": "chaxus",
  "homepage": "https://aryxn.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranuts/aryxn.git"
  },
  "bugs": {
    "url": "https://github.com/ranuts/aryxn/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --filter=@alixex/link dev",
    "build": "pnpm --filter=@alixex/link build",
    "deploy:cloudflare": "VITE_BASE_PATH=/ pnpm --filter=@alixex/link build && pnpm dlx wrangler pages deploy apps/link/dist --project-name aryxn --branch main",
    "lint": "pnpm -r --workspace-concurrency=0 --filter='./apps/*' --filter='./packages/*' lint",
    "type-check": "pnpm -r --workspace-concurrency=0 --filter='./apps/*' --filter='./packages/*' type-check",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,css,html}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,md,css,html}'",
    "ci": "pnpm lint && pnpm type-check && pnpm build",
    "preview": "pnpm --filter=@alixex/link preview"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "typescript": "~7.0.2",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}